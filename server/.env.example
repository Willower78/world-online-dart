# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Anything committed to this file is PUBLIC — never put real secrets here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# MongoDB connection string. For local dev use the Docker container
# `mongo:7` exposed on port 27017; for production use a MongoDB Atlas URI.
MONGO_URI=mongodb://localhost:27017/world-online-dart

# Symmetric signing key for JSON Web Tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_string

# Port the HTTP/Socket.IO server listens on.
PORT=5000

# Comma-separated list of allowed CORS origins (used as the socket.io and
# CORS allow-list). Leave as your client URL in dev.
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI backend
# ---------------------------------------------------------------------------
# URL of the Python dart-detection service.
AI_SERVICE_URL=http://localhost:5001/detect

# ---------------------------------------------------------------------------
# Optional: Redis (recommended for >1 server instance)
# ---------------------------------------------------------------------------
# Set to `true` to enable a real Redis client for matchmaking / online-user
# tracking. When `false` (default), the server falls back to an in-memory
# mock which is fine for a single instance but loses state on restart.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Optional: Stripe (subscription / premium)
# ---------------------------------------------------------------------------
# If STRIPE_SECRET_KEY is missing the payment routes return HTTP 503; the
# rest of the server boots normally.
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# The in-app "star" economy and Tremendous gift-card cash-out are not
# production-ready (Stripe charge + Tremendous call are still TODO). Leave
# this OFF until the economyService integration is finished — otherwise
# /api/economy/purchase and /api/economy/cash-out return 503.
ECONOMY_ENABLED=false
