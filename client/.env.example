# Copy this file to `client/.env` and fill in real values.
# Create React App ONLY reads variables prefixed with `REACT_APP_` and
# inlines them at build time — these are NOT secrets, they ship in the
# bundle to every browser.

# URL of the Node/Socket.IO server. Required when the client and server
# are deployed at different origins (Railway, Vercel + Fly, etc.).
# In dev leave this unset; the client will auto-detect from the current
# hostname.
#
# Example for Railway:
# REACT_APP_SERVER_URL=https://wodart-server-production.up.railway.app

# ---------------------------------------------------------------------------
# WebRTC ICE servers (for peer-to-peer video between players)
# ---------------------------------------------------------------------------
# Option A — single TURN server (the simple case):
# REACT_APP_TURN_URL=turn:global.relay.metered.ca:80
# REACT_APP_TURN_USERNAME=your_metered_username
# REACT_APP_TURN_CREDENTIAL=your_metered_password

# Option B — full JSON array (overrides STUN/TURN defaults entirely):
# REACT_APP_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your.turn.server:3478","username":"u","credential":"c"}]
