# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# URL of the Node.js server (used if the AI backend needs to call back).
NODE_SERVER_URL=http://localhost:5000

# Port the Flask AI service listens on.
AI_PORT=5001

# Path to the trained YOLO weights. The default points at a small model
# checked into `ai-backend/models/`.
YOLO_MODEL_PATH=./models/dart_detector.pt
